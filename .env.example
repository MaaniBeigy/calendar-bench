# -------------------------- Neo4j --------------------------
NEO4J_URI=bolt://neo4j:7687
NEO4J_HOST_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=changeme_please
NEO4J_DATABASE=neo4j

# -------- LLM providers (only fill in what you use) --------
# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic / Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# OpenRouter (OpenAI-compatible)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=anthropic/claude-sonnet-4.6

# ----------------------- Ontologies -----------------------
# BioPortal API key, most ontologies are downloaded from BioPortal.
# Get a free key at https://bioportal.bioontology.org/account
BIOPORTAL_API_KEY=

# Default provider used by the GraphRAG pipeline (openai | anthropic | openrouter)
LLM_PROVIDER=openai
# Default provider used for embedding (openai | local).
EMBEDDING_PROVIDER=openai
# OpenAI embedding model name; read when EMBEDDING_PROVIDER=openai.
EMBEDDING_MODEL=text-embedding-3-small
# Vector index dim; must match the active embedder's output dim.
# OpenAI text-embedding-3-small: 1536; BAAI/bge-large-en-v1.5: 1024;
# Qwen/Qwen3-Embedding-0.6B: 1024.
EMBEDDING_DIMENSIONS=1536
# Local sentence-transformers model; read when EMBEDDING_PROVIDER=local.
LOCAL_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
# Compute device for the local embedder (cpu | cuda | cuda:<n> | auto).
COMPUTE_DEVICE=auto
# Batch size for the bake script and for the local encoder.
EMBEDDING_BATCH_SIZE=100

# ------------------------- L_pref cache -------------------------
# Redis sidecar URL for the PreferenceMapper cache (see
# src/scripts/scenarios/metrics/REVISION_PLAN_2.md Step 10).
# The docker-compose stack ships a `redis` service and injects this
# value automatically; unset locally (or use an external Redis) and
# the cache falls back to fakeredis in-process.
REDIS_URL=redis://redis:6379/0
