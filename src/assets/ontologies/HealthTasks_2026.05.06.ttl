## ----------------------------------------------------------------------
## Calendar-Bench HealthTasks knowledge graph (with estimatedDuration)
## Generated by enrich_healthtasks_with_duration.py
## ----------------------------------------------------------------------

@prefix hb:      <https://w3id.org/calendar-bench/health/> .
@prefix hb-tk:   <https://w3id.org/calendar-bench/health/task/> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .


<https://w3id.org/calendar-bench/health/> a owl:Ontology ;
    dcterms:title       "Calendar-Bench Health Tasks ontology"@en ;
    dcterms:description "Health task benchmark organised as Intervention -> Challenge -> Difficulty -> Task. Each task carries title, description, isConcurrent, isDividable, and estimatedDurationMinutes."@en ;
    owl:versionInfo     "2026.05.06" .


## ----------------------------------------------------------------------
## Datatype properties
## ----------------------------------------------------------------------

hb:isConcurrent a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain hb:HealthTask ;
    rdfs:range  xsd:boolean ;
    rdfs:label  "is concurrent"@en ;
    rdfs:comment "True when the task is light enough to attach to another focused calendar block."@en .

hb:isDividable a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain hb:HealthTask ;
    rdfs:range  xsd:boolean ;
    rdfs:label  "is dividable"@en ;
    rdfs:comment "True when the task can be split across multiple time slots in the day."@en .

hb:estimatedDurationMinutes a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain hb:HealthTask ;
    rdfs:range  xsd:integer ;
    rdfs:label  "estimated duration in minutes"@en ;
    rdfs:comment "Realistic length in minutes per single instance of the task. Sourced from the estimated_duration column of the v8 spreadsheet."@en .

## Class hierarchy (T-Box)

hb:HealthTask a owl:Class ;
    rdfs:label   "Health Task"@en ;
    rdfs:comment "Any small, schedulable health behaviour from the calendar-bench benchmark."@en .

