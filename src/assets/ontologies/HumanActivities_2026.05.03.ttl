@prefix ha:      <https://w3id.org/calendar-bench/human-activities/> .
@prefix ha-act:  <https://w3id.org/calendar-bench/human-activities/activity/> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://w3id.org/calendar-bench/human-activities/> a owl:Ontology ;
    dcterms:title       "Calendar-Bench Human Activities ontology"@en ;
    dcterms:description "OWL hierarchy of the Compendium of Physical Activities (1210 rows), grouped by the seven top-level event categories (Sports, Work, Social, Education, Everyday Tasks, Health, Leisure). Each Activity Description is a named individual with its Activity Code and MET Value preserved verbatim."@en ;
    owl:versionInfo     "2026.05.03" .

## ----------------------------------------------------------------------
## Datatype properties
## ----------------------------------------------------------------------

ha:activityCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain ha:HumanActivity ;
    rdfs:range  xsd:integer ;
    rdfs:label  "activity code"@en ;
    rdfs:comment "Numeric Activity Code from the Compendium of Physical Activities."@en .

ha:metValue a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain ha:HumanActivity ;
    rdfs:range  xsd:decimal ;
    rdfs:label  "MET value"@en ;
    rdfs:comment "Metabolic Equivalent of Task (MET). One MET is the energy cost of sitting quietly, roughly 1 kcal/kg/hour or 3.5 ml/kg/min of oxygen uptake."@en .

## ----------------------------------------------------------------------
## Class hierarchy (T-Box)
## ----------------------------------------------------------------------

ha:HumanActivity a owl:Class ;
    rdfs:label   "Human Activity"@en ;
    rdfs:comment "Root class for any compendium-derived human activity."@en .

ha:SportsExerciseWorkout a owl:Class ;
    rdfs:subClassOf ha:HumanActivity ;
    rdfs:label "Sports, Exercise, Workout"@en .

ha:Work a owl:Class ;
    rdfs:subClassOf ha:HumanActivity ;
    rdfs:label "Work"@en .

ha:SocialFamilyFriends a owl:Class ;
    rdfs:subClassOf ha:HumanActivity ;
    rdfs:label "Social, Family, Friends"@en .

ha:Education a owl:Class ;
    rdfs:subClassOf ha:HumanActivity ;
    rdfs:label "Education"@en .

ha:EverydayTasks a owl:Class ;
    rdfs:subClassOf ha:HumanActivity ;
    rdfs:label "Everyday Tasks"@en .

ha:Health a owl:Class ;
    rdfs:subClassOf ha:HumanActivity ;
    rdfs:label "Health"@en .

ha:LeisureEntertainmentTravel a owl:Class ;
    rdfs:subClassOf ha:HumanActivity ;
    rdfs:label "Leisure, Entertainment, Travel"@en .

ha:SportsExerciseWorkoutBicycling a owl:Class ;
    rdfs:subClassOf ha:SportsExerciseWorkout ;
    rdfs:label "Bicycling"@en ;
    rdfs:comment "Major Heading from the Compendium of Physical Activities, scoped to the Sports, Exercise, Workout parent."@en .

ha:SportsExerciseWorkoutConditioningExercise a owl:Class ;
