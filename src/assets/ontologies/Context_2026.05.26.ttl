    skos:definition "A <goal setting BCT> that involves the intervention source agreeing with the person on a goal which is a positive outcome of performing the behaviour."@en .

<http://humanbehaviourchange.org/ontology/BCIO_007079> a owl:NamedIndividual , cbc:BehaviourChangeTechnique ;
    cb:slug      "alter_external_stimulus_bct" ;
    cb:category  cbc:BehaviourChangeTechnique ;
    rdfs:label   "alter external stimulus BCT"@en ;
    cb:source    "BCIO" ;
    dcterms:source cb:Source_BCIO ;
    skos:definition "An <associative learning BCT> that involves creating, strengthening or reducing an association between the behaviour and an environmental trigger."@en .

<http://humanbehaviourchange.org/ontology/BCIO_007038> a owl:NamedIndividual , cbc:BehaviourChangeTechnique ;
    cb:slug      "arrange_appraisal_support_bct" ;
    cb:category  cbc:BehaviourChangeTechnique ;
    rdfs:label   "arrange appraisal support BCT"@en ;
    cb:source    "BCIO" ;
    dcterms:source cb:Source_BCIO ;
    skos:definition "An <arrange support BCT> that organises support from another in terms of information that will aid the person in evaluating themself or the situation."@en .

<http://humanbehaviourchange.org/ontology/BCIO_007036> a owl:NamedIndividual , cbc:BehaviourChangeTechnique ;
    cb:slug      "arrange_emotional_support_bct" ;
    cb:category  cbc:BehaviourChangeTechnique ;
    rdfs:label   "arrange emotional support BCT"@en ;
    cb:source    "BCIO" ;
    dcterms:source cb:Source_BCIO ;
    skos:definition "An <arrange support BCT> that organises support from another in terms of expressing concern, caring and empathy."@en .

<http://humanbehaviourchange.org/ontology/BCIO_007037> a owl:NamedIndividual , cbc:BehaviourChangeTechnique ;
    cb:slug      "arrange_informational_support_bct" ;
    cb:category  cbc:BehaviourChangeTechnique ;
    rdfs:label   "arrange informational support BCT"@en ;
    cb:source    "BCIO" ;
    dcterms:source cb:Source_BCIO ;
    skos:definition "An <arrange support BCT> that organises support from another in terms of advice, suggestions and information."@en .

<http://humanbehaviourchange.org/ontology/BCIO_007035> a owl:NamedIndividual , cbc:BehaviourChangeTechnique ;
    cb:slug      "arrange_instrumental_support_bct" ;
    cb:category  cbc:BehaviourChangeTechnique ;
    rdfs:label   "arrange instrumental support BCT"@en ;
    cb:source    "BCIO" ;
    dcterms:source cb:Source_BCIO ;
    skos:definition "An <arrange support BCT> that organises support from another in terms of tangible aid."@en .

<http://humanbehaviourchange.org/ontology/BCIO_007087> a owl:NamedIndividual , cbc:BehaviourChangeTechnique ;
    cb:slug      "arrange_satiation_bct" ;
    cb:category  cbc:BehaviourChangeTechnique ;
    rdfs:label   "arrange satiation BCT"@en ;
    cb:source    "BCIO" ;
    dcterms:source cb:Source_BCIO ;
    skos:definition "An <expose to stimulus BCT> that provides sustained exposure to a stimulus to reduce or extinguish an unwanted behaviour."@en .

<http://humanbehaviourchange.org/ontology/BCIO_007034> a owl:NamedIndividual , cbc:BehaviourChangeTechnique ;
    cb:slug      "arrange_support_bct" ;
    cb:category  cbc:BehaviourChangeTechnique ;
    rdfs:label   "arrange support BCT"@en ;
    cb:source    "BCIO" ;
    dcterms:source cb:Source_BCIO ;
    skos:definition "A <social support BCT> that organises support from another for the person."@en .

<http://humanbehaviourchange.org/ontology/BCIO_007090> a owl:NamedIndividual , cbc:BehaviourChangeTechnique ;
    cb:slug      "associative_learning_bct" ;
    cb:category  cbc:BehaviourChangeTechnique ;
    rdfs:label   "associative learning BCT"@en ;
    cb:source    "BCIO" ;
    dcterms:source cb:Source_BCIO ;
    skos:definition "A <behaviour change technique> that involves repeated pairing of a stimulus with another stimulus or with a behavioural outcome."@en .

<http://humanbehaviourchange.org/ontology/BCIO_007091> a owl:NamedIndividual , cbc:BehaviourChangeTechnique ;
    cb:slug      "associative_learning_to_elicit_behaviour_bct" ;
    cb:category  cbc:BehaviourChangeTechnique ;
    rdfs:label   "associative learning to elicit behaviour BCT"@en ;
    cb:source    "BCIO" ;
    dcterms:source cb:Source_BCIO ;
    skos:definition "An <associative learning BCT> that involves repeated pairing of a neutral stimulus with a stimulus that already elicits the behaviour until the neutral stimulus elicits the behaviour."@en .

<http://humanbehaviourchange.org/ontology/BCIO_007092> a owl:NamedIndividual , cbc:BehaviourChangeTechnique ;
    cb:slug      "associative_learning_to_extinguish_behaviour_bct" ;
    cb:category  cbc:BehaviourChangeTechnique ;
    rdfs:label   "associative learning to extinguish behaviour BCT"@en ;
    cb:source    "BCIO" ;
    dcterms:source cb:Source_BCIO ;
    skos:definition "An <associative learning BCT> that stops the presentation of a reward for the behaviour."@en .

<http://humanbehaviourchange.org/ontology/BCIO_007012> a owl:NamedIndividual , cbc:BehaviourChangeTechnique ;
    cb:slug      "attend_to_discrepancy_between_current_behaviour_and_goal_bct" ;
    cb:category  cbc:BehaviourChangeTechnique ;
    rdfs:label   "attend to discrepancy between current behaviour and goal BCT"@en ;
    cb:source    "BCIO" ;
    dcterms:source cb:Source_BCIO ;
    skos:definition "A <goal directed BCT> that draws attention to discrepancies between a person's current behaviour and the person's outcome goal, behavioural goal or action plan."@en .

<http://humanbehaviourchange.org/ontology/BCIO_007101> a owl:NamedIndividual , cbc:BehaviourChangeTechnique ;
    cb:slug      "behavioural_consequence_bct" ;
    cb:category  cbc:BehaviourChangeTechnique ;
    rdfs:label   "behavioural consequence BCT"@en ;
    cb:source    "BCIO" ;
    dcterms:source cb:Source_BCIO ;
    skos:definition "A <behaviour change technique> that alters the consequences or promised consequences for the behaviour."@en .

<http://humanbehaviourchange.org/ontology/BCIO_050445> a owl:NamedIndividual , cbc:BehaviourChangeTechnique ;
    cb:slug      "change_behaviour_goal_bct" ;
    cb:category  cbc:BehaviourChangeTechnique ;
    rdfs:label   "change behaviour goal BCT"@en ;
    cb:source    "BCIO" ;
    dcterms:source cb:Source_BCIO ;
    skos:definition "A <goal directed BCT> that changes an existing goal for the behaviour to be achieved."@en .

<http://humanbehaviourchange.org/ontology/BCIO_050446> a owl:NamedIndividual , cbc:BehaviourChangeTechnique ;
    cb:slug      "change_outcome_goal_bct" ;
    cb:category  cbc:BehaviourChangeTechnique ;
    rdfs:label   "change outcome goal BCT"@en ;
    cb:source    "BCIO" ;
    dcterms:source cb:Source_BCIO ;
    skos:definition "A <goal directed BCT> that changes an existing goal for the outcome to be achieved."@en .

<http://humanbehaviourchange.org/ontology/BCIO_007136> a owl:NamedIndividual , cbc:BehaviourChangeTechnique ;
    cb:slug      "change_the_body_bct" ;
    cb:category  cbc:BehaviourChangeTechnique ;
    rdfs:label   "change the body BCT"@en ;
    cb:source    "BCIO" ;
    dcterms:source cb:Source_BCIO ;
    skos:definition "A <behaviour change technique> that alters the structure or functioning of the person's body."@en .

<http://humanbehaviourchange.org/ontology/BCIO_007054> a owl:NamedIndividual , cbc:BehaviourChangeTechnique ;
    cb:slug      "conduct_a_behavioural_experiment_bct" ;
    cb:category  cbc:BehaviourChangeTechnique ;
    rdfs:label   "conduct a behavioural experiment BCT"@en ;
    cb:source    "BCIO" ;
    dcterms:source cb:Source_BCIO ;
    skos:definition "A <behaviour change technique> that advises on how to identify and test hypotheses about the behaviour, its causes and consequences."@en .

<http://humanbehaviourchange.org/ontology/BCIO_007134> a owl:NamedIndividual , cbc:BehaviourChangeTechnique ;
    cb:slug      "conserve_mental_resources_bct" ;
    cb:category  cbc:BehaviourChangeTechnique ;
    rdfs:label   "conserve mental resources BCT"@en ;
    cb:source    "BCIO" ;
    dcterms:source cb:Source_BCIO ;
    skos:definition "A <manage mental processes BCT> that advises a way to minimise demands on mental resources."@en .

<http://humanbehaviourchange.org/ontology/BCIO_007069> a owl:NamedIndividual , cbc:BehaviourChangeTechnique ;
    cb:slug      "consider_pros_and_cons_bct" ;
    cb:category  cbc:BehaviourChangeTechnique ;
    rdfs:label   "consider pros and cons BCT"@en ;
    cb:source    "BCIO" ;
    dcterms:source cb:Source_BCIO ;
    skos:definition "An <increase awareness of consequences BCT> that advises identification and comparison of the positive and negative consequences of performing or not performing the behaviour."@en .

<http://humanbehaviourchange.org/ontology/BCIO_007169> a owl:NamedIndividual , cbc:BehaviourChangeTechnique ;
    cb:slug      "context_specific_non_enactment_of_behaviour_bct" ;
    cb:category  cbc:BehaviourChangeTechnique ;
    rdfs:label   "context-specific non-enactment of behaviour BCT"@en ;
    cb:source    "BCIO" ;
    dcterms:source cb:Source_BCIO ;
    skos:definition "An <advise specific behaviour BCT> that advises the person to refrain from engaging in the behaviour in a specified context."@en .

<http://humanbehaviourchange.org/ontology/BCIO_007097> a owl:NamedIndividual , cbc:BehaviourChangeTechnique ;
    cb:slug      "context_specific_repetition_of_alternative_behaviour_bct" ;
    cb:category  cbc:BehaviourChangeTechnique ;
    rdfs:label   "context-specific repetition of alternative behaviour BCT"@en ;
    cb:source    "BCIO" ;
    dcterms:source cb:Source_BCIO ;
    skos:definition "An <advise specific behaviour BCT> that advises the person to repeat an alternative behaviour consistently in a context that previously elicited an unwanted behaviour."@en .

<http://humanbehaviourchange.org/ontology/BCIO_007096> a owl:NamedIndividual , cbc:BehaviourChangeTechnique ;
    cb:slug      "context_specific_repetition_of_behaviour_bct" ;
    cb:category  cbc:BehaviourChangeTechnique ;
    rdfs:label   "context-specific repetition of behaviour BCT"@en ;
    cb:source    "BCIO" ;
    dcterms:source cb:Source_BCIO ;
    skos:definition "An <advise specific behaviour BCT> that advises the person to repeat the behaviour in the same context."@en .

<http://humanbehaviourchange.org/ontology/BCIO_007014> a owl:NamedIndividual , cbc:BehaviourChangeTechnique ;
    cb:slug      "create_behavioural_contract_bct" ;
    cb:category  cbc:BehaviourChangeTechnique ;
    rdfs:label   "create behavioural contract BCT"@en ;
    cb:source    "BCIO" ;
    dcterms:source cb:Source_BCIO ;
    skos:definition "A <goal directed BCT> that creates a written specification of the behaviour to be performed, agreed on by the person, and witnessed by another person."@en .

<http://humanbehaviourchange.org/ontology/BCIO_007081> a owl:NamedIndividual , cbc:BehaviourChangeTechnique ;
    cb:slug      "cue_bct" ;
    cb:category  cbc:BehaviourChangeTechnique ;
    rdfs:label   "cue BCT"@en ;
    cb:source    "BCIO" ;
    dcterms:source cb:Source_BCIO ;
    skos:definition "An <alter external stimulus BCT> that introduces external information that is already associated with the behaviour in order to elicit that behaviour."@en .

<http://humanbehaviourchange.org/ontology/BCIO_007082> a owl:NamedIndividual , cbc:BehaviourChangeTechnique ;
    cb:slug      "cue_signalling_reward_bct" ;
    cb:category  cbc:BehaviourChangeTechnique ;
    rdfs:label   "cue signalling reward BCT"@en ;
    cb:source    "BCIO" ;
    dcterms:source cb:Source_BCIO ;
    skos:definition "An <alter external stimulus BCT> that identifies an external stimulus that reliably signals that reward will follow the behaviour."@en .

<http://humanbehaviourchange.org/ontology/BCIO_007043> a owl:NamedIndividual , cbc:BehaviourChangeTechnique ;
    cb:slug      "deliver_appraisal_support_bct" ;
    cb:category  cbc:BehaviourChangeTechnique ;
    rdfs:label   "deliver appraisal support BCT"@en ;
    cb:source    "BCIO" ;
    dcterms:source cb:Source_BCIO ;
    skos:definition "A <deliver support BCT> that provides information that will aid the person in evaluating themself or the situation."@en .

<http://humanbehaviourchange.org/ontology/BCIO_007041> a owl:NamedIndividual , cbc:BehaviourChangeTechnique ;
    cb:slug      "deliver_emotional_support_bct" ;
    cb:category  cbc:BehaviourChangeTechnique ;
    rdfs:label   "deliver emotional support BCT"@en ;
    cb:source    "BCIO" ;
    dcterms:source cb:Source_BCIO ;
    skos:definition "A <deliver support BCT> that provides expressions of concern, caring and empathy."@en .

<http://humanbehaviourchange.org/ontology/BCIO_007042> a owl:NamedIndividual , cbc:BehaviourChangeTechnique ;
    cb:slug      "deliver_informational_support_bct" ;
    cb:category  cbc:BehaviourChangeTechnique ;
    rdfs:label   "deliver informational support BCT"@en ;
    cb:source    "BCIO" ;
    dcterms:source cb:Source_BCIO ;
    skos:definition "A <deliver support BCT> that provides advice, suggestions and information."@en .

<http://humanbehaviourchange.org/ontology/BCIO_007040> a owl:NamedIndividual , cbc:BehaviourChangeTechnique ;
    cb:slug      "deliver_instrumental_support_bct" ;
    cb:category  cbc:BehaviourChangeTechnique ;
    rdfs:label   "deliver instrumental support BCT"@en ;
    cb:source    "BCIO" ;
    dcterms:source cb:Source_BCIO ;
    skos:definition "A <deliver support BCT> that provides tangible aid."@en .

<http://humanbehaviourchange.org/ontology/BCIO_007039> a owl:NamedIndividual , cbc:BehaviourChangeTechnique ;
    cb:slug      "deliver_support_bct" ;
    cb:category  cbc:BehaviourChangeTechnique ;
    rdfs:label   "deliver support BCT"@en ;
    cb:source    "BCIO" ;
    dcterms:source cb:Source_BCIO ;
    skos:definition "A <social support BCT> that directly provides support to the person."@en .

<http://humanbehaviourchange.org/ontology/BCIO_007055> a owl:NamedIndividual , cbc:BehaviourChangeTechnique ;
    cb:slug      "demonstrate_the_behaviour_bct" ;
    cb:category  cbc:BehaviourChangeTechnique ;
    rdfs:label   "demonstrate the behaviour BCT"@en ;
    cb:source    "BCIO" ;
    dcterms:source cb:Source_BCIO ;
    skos:definition "A <guide how to perform behaviour BCT> that provides an observable sample of the performance of the behaviour for the person to aspire to or imitate."@en .

<http://humanbehaviourchange.org/ontology/BCIO_007151> a owl:NamedIndividual , cbc:BehaviourChangeTechnique ;
    cb:slug      "directly_restructure_the_physical_environment_bct" ;
    cb:category  cbc:BehaviourChangeTechnique ;
    rdfs:label   "directly restructure the physical environment BCT"@en ;
    cb:source    "BCIO" ;
    dcterms:source cb:Source_BCIO ;
    skos:definition "A <restructure the physical environment BCT> that changes the person’s directly experienced environment at the time the behaviour is, or would have been, performed."@en .

<http://humanbehaviourchange.org/ontology/BCIO_050346> a owl:NamedIndividual , cbc:BehaviourChangeTechnique ;
    cb:slug      "directly_restructure_the_social_environment_bct" ;
    cb:category  cbc:BehaviourChangeTechnique ;
    rdfs:label   "directly restructure the social environment BCT"@en ;
    cb:source    "BCIO" ;
    dcterms:source cb:Source_BCIO ;
    skos:definition "A <restructure the social environment BCT> that changes the person's directly experienced environment at the time the behaviour is, or would have been, performed."@en .

<http://humanbehaviourchange.org/ontology/BCIO_007057> a owl:NamedIndividual , cbc:BehaviourChangeTechnique ;
    cb:slug      "draw_attention_to_incompatible_beliefs_bct" ;
    cb:category  cbc:BehaviourChangeTechnique ;
    rdfs:label   "draw attention to incompatible beliefs BCT"@en ;
    cb:source    "BCIO" ;
    dcterms:source cb:Source_BCIO ;
    skos:definition "A <suggest different perspective on behaviour BCT> that draws the person's attention to the discrepancies between current or past behaviour and self-identity."@en .

<http://humanbehaviourchange.org/ontology/BCIO_007146> a owl:NamedIndividual , cbc:BehaviourChangeTechnique ;
    cb:slug      "encourage_pharmacological_support_bct" ;
    cb:category  cbc:BehaviourChangeTechnique ;
    rdfs:label   "encourage pharmacological support BCT"@en ;
    cb:source    "BCIO" ;
    dcterms:source cb:Source_BCIO ;
    skos:definition "A <promote pharmacological support BCT> that encourages the person to use medicines or other drugs."@en .

<http://humanbehaviourchange.org/ontology/BCIO_007085> a owl:NamedIndividual , cbc:BehaviourChangeTechnique ;
    cb:slug      "expose_to_stimulus_bct" ;
    cb:category  cbc:BehaviourChangeTechnique ;
    rdfs:label   "expose to stimulus BCT"@en ;
    cb:source    "BCIO" ;
    dcterms:source cb:Source_BCIO ;
    skos:definition "An <alter external stimulus BCT> that sustains the person's exposure to a stimulus associated with the behaviour."@en .

<http://humanbehaviourchange.org/ontology/BCIO_007170> a owl:NamedIndividual , cbc:BehaviourChangeTechnique ;
    cb:slug      "expose_to_sustained_aversive_stimulus_bct" ;
    cb:category  cbc:BehaviourChangeTechnique ;
    rdfs:label   "expose to sustained aversive stimulus BCT"@en ;
    cb:source    "BCIO" ;
    dcterms:source cb:Source_BCIO ;
    skos:definition "An <expose to stimulus BCT> that involves sustained exposure to an aversive stimulus to reduce the likelihood of the behaviour when encountering that stimulus."@en .

<http://humanbehaviourchange.org/ontology/BCIO_007171> a owl:NamedIndividual , cbc:BehaviourChangeTechnique ;
    cb:slug      "facilitate_alternative_goal_directed_activity_bct" ;
    cb:category  cbc:BehaviourChangeTechnique ;
    rdfs:label   "facilitate alternative goal-directed activity BCT"@en ;
    cb:source    "BCIO" ;
    dcterms:source cb:Source_BCIO ;
    skos:definition "A <goal directed BCT> that enables the person to engage in an alternative rewarding behaviour that increases the likelihood of goal achievement."@en .

<http://humanbehaviourchange.org/ontology/BCIO_007099> a owl:NamedIndividual , cbc:BehaviourChangeTechnique ;
    cb:slug      "generalise_behaviour_bct" ;
    cb:category  cbc:BehaviourChangeTechnique ;
    rdfs:label   "generalise behaviour BCT"@en ;
    cb:source    "BCIO" ;
    dcterms:source cb:Source_BCIO ;
    skos:definition "An <advise specific behaviour BCT> that advises the person to perform the behaviour which is already performed in a particular context, in a similar context."@en .

<http://humanbehaviourchange.org/ontology/BCIO_007001> a owl:NamedIndividual , cbc:BehaviourChangeTechnique ;
    cb:slug      "goal_directed_bct" ;
    cb:category  cbc:BehaviourChangeTechnique ;
    rdfs:label   "goal directed BCT"@en ;
    cb:source    "BCIO" ;
    dcterms:source cb:Source_BCIO ;
    skos:definition "A <behaviour change technique> that sets or changes goals."@en .

<http://humanbehaviourchange.org/ontology/BCIO_007002> a owl:NamedIndividual , cbc:BehaviourChangeTechnique ;
    cb:slug      "goal_setting_bct" ;
    cb:category  cbc:BehaviourChangeTechnique ;
    rdfs:label   "goal setting BCT"@en ;
    cb:source    "BCIO" ;
    dcterms:source cb:Source_BCIO ;
    skos:definition "A <goal directed BCT> that sets goals."@en .

<http://humanbehaviourchange.org/ontology/BCIO_007008> a owl:NamedIndividual , cbc:BehaviourChangeTechnique ;
    cb:slug      "goal_strategising_bct" ;
    cb:category  cbc:BehaviourChangeTechnique ;
    rdfs:label   "goal strategising BCT"@en ;
    cb:source    "BCIO" ;
    dcterms:source cb:Source_BCIO ;
    skos:definition "A <goal directed BCT> in which the person analyses factors influencing the behaviour and generates, selects, or reviews strategies to increase facilitators and overcome barriers."@en .

<http://humanbehaviourchange.org/ontology/BCIO_007172> a owl:NamedIndividual , cbc:BehaviourChangeTechnique ;
    cb:slug      "gradually_increase_exposure_to_aversive_stimulus_bct" ;
    cb:category  cbc:BehaviourChangeTechnique ;
    rdfs:label   "gradually increase exposure to aversive stimulus BCT"@en ;
    cb:source    "BCIO" ;
    dcterms:source cb:Source_BCIO ;
    skos:definition "An <expose to stimulus BCT> that involves gradually increasing exposure to an aversive stimulus to reduce the likelihood of the behaviour when encountering that stimulus."@en .

<http://humanbehaviourchange.org/ontology/BCIO_007050> a owl:NamedIndividual , cbc:BehaviourChangeTechnique ;
    cb:slug      "guide_how_to_perform_behaviour_bct" ;
    cb:category  cbc:BehaviourChangeTechnique ;
    rdfs:label   "guide how to perform behaviour BCT"@en ;
    cb:source    "BCIO" ;
    dcterms:source cb:Source_BCIO ;
    skos:definition "A <behaviour change technique> that provides guidance regarding how to perform the behaviour."@en .

<http://humanbehaviourchange.org/ontology/BCIO_007158> a owl:NamedIndividual , cbc:BehaviourChangeTechnique ;
    cb:slug      "identify_self_as_role_model_bct" ;
    cb:category  cbc:BehaviourChangeTechnique ;
    rdfs:label   "identify self as role model BCT"@en ;
    cb:source    "BCIO" ;
    dcterms:source cb:Source_BCIO ;
    skos:definition "A <prompt focus on self-identity BCT> that informs the person that their behaviour may be an example to others."@en .

<http://humanbehaviourchange.org/ontology/BCIO_007118> a owl:NamedIndividual , cbc:BehaviourChangeTechnique ;
    cb:slug      "imagine_punishment_bct" ;
    cb:category  cbc:BehaviourChangeTechnique ;
    rdfs:label   "imagine punishment BCT"@en ;
    cb:source    "BCIO" ;
    dcterms:source cb:Source_BCIO ;
    skos:definition "An <increase awareness of consequences BCT> that guides the person to imagine performing the unwanted behaviour in a real-life situation followed by experiencing an unpleasant consequence for performing that behaviour."@en .

<http://humanbehaviourchange.org/ontology/BCIO_007119> a owl:NamedIndividual , cbc:BehaviourChangeTechnique ;
    cb:slug      "imagine_reward_bct" ;
    cb:category  cbc:BehaviourChangeTechnique ;
    rdfs:label   "imagine reward BCT"@en ;
    cb:source    "BCIO" ;
    dcterms:source cb:Source_BCIO ;
    skos:definition "An <increase awareness of consequences BCT> that guides the person to imagine performing the wanted behaviour in a real-life situation followed by experiencing a pleasant consequence for performing that behaviour."@en .

<http://humanbehaviourchange.org/ontology/BCIO_007078> a owl:NamedIndividual , cbc:BehaviourChangeTechnique ;
    cb:slug      "implore_to_change_behaviour_bct" ;
    cb:category  cbc:BehaviourChangeTechnique ;
    rdfs:label   "implore to change behaviour BCT"@en ;
    cb:source    "BCIO" ;
    dcterms:source cb:Source_BCIO ;
    skos:definition "An <awareness of other people's thoughts, feelings and actions BCT> that makes an emotional or earnest appeal to change the person's behaviour."@en .

<http://humanbehaviourchange.org/ontology/BCIO_007173> a owl:NamedIndividual , cbc:BehaviourChangeTechnique ;
    cb:slug      "increase_awareness_of_behaviour_bct" ;
    cb:category  cbc:BehaviourChangeTechnique ;
    rdfs:label   "increase awareness of behaviour BCT"@en ;
    cb:source    "BCIO" ;
    dcterms:source cb:Source_BCIO ;
    skos:definition "A <behaviour change technique> that draws attention to the behaviour."@en .

<http://humanbehaviourchange.org/ontology/BCIO_007062> a owl:NamedIndividual , cbc:BehaviourChangeTechnique ;
    cb:slug      "increase_awareness_of_consequences_bct" ;
    cb:category  cbc:BehaviourChangeTechnique ;
    rdfs:label   "increase awareness of consequences BCT"@en ;
    cb:source    "BCIO" ;
    dcterms:source cb:Source_BCIO ;
    skos:definition "A <behaviour change technique> that draws attention to consequences of the behaviour in the normal course of events."@en .

<http://humanbehaviourchange.org/ontology/BCIO_007174> a owl:NamedIndividual , cbc:BehaviourChangeTechnique ;
    cb:slug      "increase_awareness_of_option_of_novel_behaviour_bct" ;
    cb:category  cbc:BehaviourChangeTechnique ;
    rdfs:label   "increase awareness of option of novel behaviour BCT"@en ;
    cb:source    "BCIO" ;
    dcterms:source cb:Source_BCIO ;
    skos:definition "An <increase awareness of behaviour BCT> that draws attention to the possibility of performing a novel behaviour."@en .

<http://humanbehaviourchange.org/ontology/BCIO_007074> a owl:NamedIndividual , cbc:BehaviourChangeTechnique ;
    cb:slug      "increase_awareness_of_others_approval_bct" ;
    cb:category  cbc:BehaviourChangeTechnique ;
    rdfs:label   "increase awareness of others approval BCT"@en ;
    cb:source    "BCIO" ;
    dcterms:source cb:Source_BCIO ;
    skos:definition "An <awareness of other people's thoughts, feelings and actions BCT> that increases awareness of whether others will like, approve, dislike, or disapprove of the behaviour."@en .

<http://humanbehaviourchange.org/ontology/BCIO_007175> a owl:NamedIndividual , cbc:BehaviourChangeTechnique ;
    cb:slug      "increase_salience_of_behaviour_bct" ;
    cb:category  cbc:BehaviourChangeTechnique ;
    rdfs:label   "increase salience of behaviour BCT"@en ;
    cb:source    "BCIO" ;
    dcterms:source cb:Source_BCIO ;
    skos:definition "An <increase awareness of behaviour BCT> that makes the possibility of performing the behaviour more distinctive or prominent."@en .

<http://humanbehaviourchange.org/ontology/BCIO_007068> a owl:NamedIndividual , cbc:BehaviourChangeTechnique ;
    cb:slug      "increase_salience_of_consequences_bct" ;
    cb:category  cbc:BehaviourChangeTechnique ;
    rdfs:label   "increase salience of consequences BCT"@en ;
    cb:source    "BCIO" ;
    dcterms:source cb:Source_BCIO ;
    skos:definition "An <awareness of consequences BCT> that changes behaviour by the source emphasising the consequences of performing a behaviour to the person in a way that makes them memorable."@en .

<http://humanbehaviourchange.org/ontology/BCIO_007152> a owl:NamedIndividual , cbc:BehaviourChangeTechnique ;
    cb:slug      "indirectly_restructure_the_physical_environment_bct" ;
    cb:category  cbc:BehaviourChangeTechnique ;
    rdfs:label   "indirectly restructure the physical environment BCT"@en ;
    cb:source    "BCIO" ;
    dcterms:source cb:Source_BCIO ;
    skos:definition "A <restructure the physical environment BCT> that changes the person's environment at a time or location other than when and where the behaviour is performed."@en .

<http://humanbehaviourchange.org/ontology/BCIO_050347> a owl:NamedIndividual , cbc:BehaviourChangeTechnique ;
    cb:slug      "indirectly_restructure_the_social_environment_bct" ;
    cb:category  cbc:BehaviourChangeTechnique ;
    rdfs:label   "indirectly restructure the social environment BCT"@en ;
    cb:source    "BCIO" ;
    dcterms:source cb:Source_BCIO ;
    skos:definition "A <restructure the social environment BCT> that changes the person's environment at a time or location other than when and where the behaviour is performed."@en .

<http://humanbehaviourchange.org/ontology/BCIO_007067> a owl:NamedIndividual , cbc:BehaviourChangeTechnique ;
    cb:slug      "induce_anticipated_regret_bct" ;
    cb:category  cbc:BehaviourChangeTechnique ;
    rdfs:label   "induce anticipated regret BCT"@en ;
    cb:source    "BCIO" ;
    dcterms:source cb:Source_BCIO ;
    skos:definition "An <inform about emotional consequences BCT> that focuses on expectations of remorse after performing or not performing the behaviour."@en .

<http://humanbehaviourchange.org/ontology/BCIO_007052> a owl:NamedIndividual , cbc:BehaviourChangeTechnique ;
    cb:slug      "inform_about_antecedents_bct" ;
    cb:category  cbc:BehaviourChangeTechnique ;
    rdfs:label   "inform about antecedents BCT"@en ;
    cb:source    "BCIO" ;
    dcterms:source cb:Source_BCIO ;
    skos:definition "A <suggest different perspective on behaviour BCT> that involves providing factual information to the person regarding triggers or influences that precede the initiation of the behaviour."@en .

<http://humanbehaviourchange.org/ontology/BCIO_007065> a owl:NamedIndividual , cbc:BehaviourChangeTechnique ;
    cb:slug      "inform_about_emotional_consequences_bct" ;
    cb:category  cbc:BehaviourChangeTechnique ;
    rdfs:label   "inform about emotional consequences BCT"@en ;
    cb:source    "BCIO" ;
    dcterms:source cb:Source_BCIO ;
    skos:definition "An <increase awareness of consequences BCT> that provides information about the emotional consequences of performing or not performing the behaviour."@en .

