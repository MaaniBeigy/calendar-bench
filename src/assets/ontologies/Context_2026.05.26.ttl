<http://humanbehaviourchange.org/ontology/BCIO_007150> a owl:NamedIndividual , cbc:BehaviourChangeTechnique ;
    cb:slug      "restructure_the_environment_bct" ;
    cb:category  cbc:BehaviourChangeTechnique ;
    rdfs:label   "restructure the environment BCT"@en ;
    cb:source    "BCIO" ;
    dcterms:source cb:Source_BCIO ;
    skos:definition "A <behaviour change technique> that alters the environment in which the behaviour is, or would have been, performed in a way that facilitates or impedes the behaviour."@en .

<http://humanbehaviourchange.org/ontology/BCIO_050348> a owl:NamedIndividual , cbc:BehaviourChangeTechnique ;
    cb:slug      "restructure_the_physical_environment_bct" ;
    cb:category  cbc:BehaviourChangeTechnique ;
    rdfs:label   "restructure the physical environment BCT"@en ;
    cb:source    "BCIO" ;
    dcterms:source cb:Source_BCIO ;
    skos:definition "A <restructure the environment BCT> that alters the physical environment in which the behaviour is, or would have been, performed in a way that facilitates or impedes the behaviour."@en .

<http://humanbehaviourchange.org/ontology/BCIO_050349> a owl:NamedIndividual , cbc:BehaviourChangeTechnique ;
    cb:slug      "restructure_the_social_environment_bct" ;
    cb:category  cbc:BehaviourChangeTechnique ;
    rdfs:label   "restructure the social environment BCT"@en ;
    cb:source    "BCIO" ;
    dcterms:source cb:Source_BCIO ;
    skos:definition "A <restructure the environment BCT> that alters the social environment in which the behaviour is, or would have been, performed in a way that facilitates or impedes the behaviour."@en .

<http://humanbehaviourchange.org/ontology/BCIO_007011> a owl:NamedIndividual , cbc:BehaviourChangeTechnique ;
    cb:slug      "review_behaviour_goal_bct" ;
    cb:category  cbc:BehaviourChangeTechnique ;
    rdfs:label   "review behaviour goal BCT"@en ;
    cb:source    "BCIO" ;
    dcterms:source cb:Source_BCIO ;
    skos:definition "A <goal directed BCT> that reviews a behavioural goal and considers modifying the goal in light of progress toward the goal."@en .

<http://humanbehaviourchange.org/ontology/BCIO_007299> a owl:NamedIndividual , cbc:BehaviourChangeTechnique ;
    cb:slug      "review_behaviour_goal_plan_bct" ;
    cb:category  cbc:BehaviourChangeTechnique ;
    rdfs:label   "review behaviour goal plan BCT"@en ;
    cb:source    "BCIO" ;
    dcterms:source cb:Source_BCIO ;
    skos:definition "A <goal directed BCT> that reviews progress towards a behavioural goal and considers modifying the plan to achieve the goal."@en .

<http://humanbehaviourchange.org/ontology/BCIO_007013> a owl:NamedIndividual , cbc:BehaviourChangeTechnique ;
    cb:slug      "review_outcome_goal_bct" ;
    cb:category  cbc:BehaviourChangeTechnique ;
    rdfs:label   "review outcome goal BCT"@en ;
    cb:source    "BCIO" ;
    dcterms:source cb:Source_BCIO ;
    skos:definition "A <goal directed BCT> that reviews an outcome goal and considers modifying the goal in light of achievement."@en .

<http://humanbehaviourchange.org/ontology/BCIO_007024> a owl:NamedIndividual , cbc:BehaviourChangeTechnique ;
    cb:slug      "self_monitor_behaviour_bct" ;
    cb:category  cbc:BehaviourChangeTechnique ;
    rdfs:label   "self-monitor behaviour BCT"@en ;
    cb:source    "BCIO" ;
    dcterms:source cb:Source_BCIO ;
    skos:definition "A <monitoring BCT> in which the person uses a method to monitor and record their behaviour."@en .

<http://humanbehaviourchange.org/ontology/BCIO_007025> a owl:NamedIndividual , cbc:BehaviourChangeTechnique ;
    cb:slug      "self_monitor_outcome_of_behaviour_bct" ;
    cb:category  cbc:BehaviourChangeTechnique ;
    rdfs:label   "self-monitor outcome of behaviour BCT"@en ;
    cb:source    "BCIO" ;
    dcterms:source cb:Source_BCIO ;
    skos:definition "A <monitoring BCT> in which the person uses a method to monitor and record an outcome of their behaviour."@en .

<http://humanbehaviourchange.org/ontology/BCIO_007003> a owl:NamedIndividual , cbc:BehaviourChangeTechnique ;
    cb:slug      "set_behaviour_goal_bct" ;
    cb:category  cbc:BehaviourChangeTechnique ;
    rdfs:label   "set behaviour goal BCT"@en ;
    cb:source    "BCIO" ;
    dcterms:source cb:Source_BCIO ;
    skos:definition "A <goal setting BCT> that sets a goal for the behaviour to be achieved."@en .

<http://humanbehaviourchange.org/ontology/BCIO_007100> a owl:NamedIndividual , cbc:BehaviourChangeTechnique ;
    cb:slug      "set_graded_tasks_bct" ;
    cb:category  cbc:BehaviourChangeTechnique ;
    rdfs:label   "set graded tasks BCT"@en ;
    cb:source    "BCIO" ;
    dcterms:source cb:Source_BCIO ;
    skos:definition "A <goal directed BCT> that sets easy-to-perform tasks for the person, making them increasingly difficult, but achievable, until the behaviour is performed."@en .

<http://humanbehaviourchange.org/ontology/BCIO_007300> a owl:NamedIndividual , cbc:BehaviourChangeTechnique ;
    cb:slug      "set_measurable_behaviour_goal_bct" ;
    cb:category  cbc:BehaviourChangeTechnique ;
    rdfs:label   "set measurable behaviour goal BCT"@en ;
    cb:source    "BCIO" ;
    dcterms:source cb:Source_BCIO ;
    skos:definition "A <set behaviour goal BCT> that describes the behaviour to be achieved in terms of a measurable target."@en .

<http://humanbehaviourchange.org/ontology/BCIO_007301> a owl:NamedIndividual , cbc:BehaviourChangeTechnique ;
    cb:slug      "set_measurable_outcome_goal_bct" ;
    cb:category  cbc:BehaviourChangeTechnique ;
    rdfs:label   "set measurable outcome goal BCT"@en ;
    cb:source    "BCIO" ;
    dcterms:source cb:Source_BCIO ;
    skos:definition "A <set outcome goal BCT> that describes the behavioural outcome to be achieved in terms of a measurable target."@en .

<http://humanbehaviourchange.org/ontology/BCIO_007005> a owl:NamedIndividual , cbc:BehaviourChangeTechnique ;
    cb:slug      "set_outcome_goal_bct" ;
    cb:category  cbc:BehaviourChangeTechnique ;
    rdfs:label   "set outcome goal BCT"@en ;
    cb:source    "BCIO" ;
    dcterms:source cb:Source_BCIO ;
    skos:definition "A <goal setting BCT> in which the goal is a positive outcome of performing the behaviour."@en .

<http://humanbehaviourchange.org/ontology/BCIO_007028> a owl:NamedIndividual , cbc:BehaviourChangeTechnique ;
    cb:slug      "social_support_bct" ;
    cb:category  cbc:BehaviourChangeTechnique ;
    rdfs:label   "social support BCT"@en ;
    cb:source    "BCIO" ;
    dcterms:source cb:Source_BCIO ;
    skos:definition "A <behaviour change technique> that involves taking steps to secure or deliver the support or aid of another person."@en .

<http://humanbehaviourchange.org/ontology/BCIO_007095> a owl:NamedIndividual , cbc:BehaviourChangeTechnique ;
    cb:slug      "substitute_behaviour_bct" ;
    cb:category  cbc:BehaviourChangeTechnique ;
    rdfs:label   "substitute behaviour BCT"@en ;
    cb:source    "BCIO" ;
    dcterms:source cb:Source_BCIO ;
    skos:definition "An <advise specific behaviour BCT> that advises the person to replace the unwanted behaviour with another behaviour."@en .

<http://humanbehaviourchange.org/ontology/BCIO_007302> a owl:NamedIndividual , cbc:BehaviourChangeTechnique ;
    cb:slug      "suggest_different_perspective_on_behaviour_bct" ;
    cb:category  cbc:BehaviourChangeTechnique ;
    rdfs:label   "suggest different perspective on behaviour BCT"@en ;
    cb:source    "BCIO" ;
    dcterms:source cb:Source_BCIO ;
    skos:definition "A <behaviour change technique> that suggests the deliberate adoption of a new perspective on the behaviour."@en .

<http://humanbehaviourchange.org/ontology/BCIO_007303> a owl:NamedIndividual , cbc:BehaviourChangeTechnique ;
    cb:slug      "suggest_how_to_perform_behaviour_bct" ;
    cb:category  cbc:BehaviourChangeTechnique ;
    rdfs:label   "suggest how to perform behaviour BCT"@en ;
    cb:source    "BCIO" ;
    dcterms:source cb:Source_BCIO ;
    skos:definition "A <guide how to perform behaviour BCT> that provides a suggestion regarding how to perform the behaviour."@en .

<http://humanbehaviourchange.org/ontology/BCIO_007076> a owl:NamedIndividual , cbc:BehaviourChangeTechnique ;
    cb:slug      "suggest_to_change_behaviour_bct" ;
    cb:category  cbc:BehaviourChangeTechnique ;
    rdfs:label   "suggest to change behaviour BCT"@en ;
    cb:source    "BCIO" ;
    dcterms:source cb:Source_BCIO ;
    skos:definition "An <awareness of other people's thoughts, feelings and actions BCT> that involves sharing a view about what behaviour the person should do."@en .

<http://humanbehaviourchange.org/ontology/BCIO_007089> a owl:NamedIndividual , cbc:BehaviourChangeTechnique ;
    cb:slug      "systematically_desensitise_bct" ;
    cb:category  cbc:BehaviourChangeTechnique ;
    rdfs:label   "systematically desensitise BCT"@en ;
    cb:source    "BCIO" ;
    dcterms:source cb:Source_BCIO ;
    skos:definition "An <expose to stimulus BCT> that gradually exposes the person to an aversive stimulus while also engaging them in a relaxation process to reduce the response to that stimulus."@en .

<http://humanbehaviourchange.org/ontology/BCIO_007077> a owl:NamedIndividual , cbc:BehaviourChangeTechnique ;
    cb:slug      "tell_to_change_behaviour_bct" ;
    cb:category  cbc:BehaviourChangeTechnique ;
    rdfs:label   "tell to change behaviour BCT"@en ;
    cb:source    "BCIO" ;
    dcterms:source cb:Source_BCIO ;
    skos:definition "An <awareness of other people's thoughts, feelings and actions BCT> that involves telling the person to perform the behaviour."@en .

<http://humanbehaviourchange.org/ontology/BCIO_007121> a owl:NamedIndividual , cbc:BehaviourChangeTechnique ;
    cb:slug      "vicarious_punishment_bct" ;
    cb:category  cbc:BehaviourChangeTechnique ;
    rdfs:label   "vicarious punishment BCT"@en ;
    cb:source    "BCIO" ;
    dcterms:source cb:Source_BCIO ;
    skos:definition "An <increase awareness of consequences BCT> that prompts observation of another person being punished when they perform the behaviour."@en .

<http://humanbehaviourchange.org/ontology/BCIO_007120> a owl:NamedIndividual , cbc:BehaviourChangeTechnique ;
    cb:slug      "vicarious_reward_bct" ;
    cb:category  cbc:BehaviourChangeTechnique ;
    rdfs:label   "vicarious reward BCT"@en ;
    cb:source    "BCIO" ;
    dcterms:source cb:Source_BCIO ;
    skos:definition "An <increase awareness of consequences BCT> that prompts observation of another person being rewarded when they perform the behaviour."@en .


## ----- sdt_regulation (6 entries) -----

<https://w3id.org/calendar-bench/context#sdt_regulation/Amotivation> a owl:NamedIndividual , cbc:SDTRegulation ;
    cb:slug      "amotivation" ;
    cb:category  cbc:SDTRegulation ;
    rdfs:label   "amotivation (SDT regulation)"@en ;
    cb:source    "calendar-bench" ;
    dcterms:source cb:Source_calendar_bench ;
    skos:definition "SDT 'amotivation' — the lack of intention to act on a behaviour."@en ;
    cb:sdtLabel  "Amotivation" .

<http://humanbehaviourchange.org/ontology/BCIO_006086> a owl:NamedIndividual , cbc:SDTRegulation ;
    cb:slug      "external_regulation" ;
    cb:category  cbc:SDTRegulation ;
    rdfs:label   "behavioural opportunity"@en ;
    cb:source    "BCIO" ;
    dcterms:source cb:Source_BCIO ;
    skos:definition "SDT 'external regulation' — acting to obtain rewards or avoid punishment."@en ;
    cb:sdtLabel  "External regulation" .

<http://humanbehaviourchange.org/ontology/BCIO_006105> a owl:NamedIndividual , cbc:SDTRegulation ;
    cb:slug      "introjected_regulation" ;
    cb:category  cbc:SDTRegulation ;
    rdfs:label   "introjected self-regulation"@en ;
    cb:source    "BCIO" ;
    dcterms:source cb:Source_BCIO ;
    skos:definition "SDT 'introjected regulation' — acting to avoid guilt or for ego."@en ;
    cb:sdtLabel  "Introjected regulation" .

<http://humanbehaviourchange.org/ontology/BCIO_050843> a owl:NamedIndividual , cbc:SDTRegulation ;
    cb:slug      "identified_regulation" ;
    cb:category  cbc:SDTRegulation ;
    rdfs:label   "accepting responsibility for changing one's behaviour"@en ;
    cb:source    "BCIO" ;
    dcterms:source cb:Source_BCIO ;
    skos:definition "SDT 'identified regulation' — acting because the behaviour is personally valued."@en ;
    cb:sdtLabel  "Identified regulation" .

<http://humanbehaviourchange.org/ontology/BCIO_006136> a owl:NamedIndividual , cbc:SDTRegulation ;
    cb:slug      "intrinsic_motivation" ;
    cb:category  cbc:SDTRegulation ;
    rdfs:label   "intrinsic motivation"@en ;
    cb:source    "BCIO" ;
    dcterms:source cb:Source_BCIO ;
    skos:definition "SDT 'intrinsic motivation' — acting for the inherent enjoyment of the behaviour."@en ;
    cb:sdtLabel  "Intrinsic motivation" .

<http://humanbehaviourchange.org/ontology/BCIO_006302> a owl:NamedIndividual , cbc:SDTRegulation ;
    cb:slug      "autonomous_motivation" ;
    cb:category  cbc:SDTRegulation ;
    rdfs:label   "autonomous motivation"@en ;
    cb:source    "BCIO" ;
    dcterms:source cb:Source_BCIO ;
    skos:definition "SDT 'autonomous motivation' umbrella — identified + integrated + intrinsic."@en ;
    cb:sdtLabel  "Autonomous motivation" .


## ----- delivery_style (10 entries) -----

<https://w3id.org/calendar-bench/context#delivery_style/Default> a owl:NamedIndividual , cbc:DeliveryStyle ;
    cb:slug      "default" ;
    cb:category  cbc:DeliveryStyle ;
    rdfs:label   "default-based delivery"@en ;
    cb:source    "Bergram 2022" ;
    dcterms:source cb:Source_Bergram_2022 ;
    skos:definition "The recommendation pre-selects the desired option so the user receives the healthy choice unless they actively change it (opt-out structure). Use when the task is a one-shot substitution / setting / swap where flipping the default is the mechanism (Bergram et al. 2022, §4.1)."@en .

<https://w3id.org/calendar-bench/context#delivery_style/Reinforcement> a owl:NamedIndividual , cbc:DeliveryStyle ;
    cb:slug      "reinforcement" ;
    cb:category  cbc:DeliveryStyle ;
    rdfs:label   "reinforcement-based delivery"@en ;
    cb:source    "Bergram 2022" ;
    dcterms:source cb:Source_Bergram_2022 ;
    skos:definition "The recommendation increases salience of the desired behaviour via repetition, priming, anchoring, or persistent cues. Use when the task relies on rehearsal, visible reminders, or accumulated exposure rather than a single point-of-decision intervention (Bergram et al. 2022, §4.1)."@en .

<https://w3id.org/calendar-bench/context#delivery_style/Social> a owl:NamedIndividual , cbc:DeliveryStyle ;
    cb:slug      "social" ;
    cb:category  cbc:DeliveryStyle ;
    rdfs:label   "social-norm delivery"@en ;
    cb:source    "Bergram 2022" ;
    dcterms:source cb:Source_Bergram_2022 ;
    skos:definition "The recommendation surfaces how peers / family / community behave, leveraging social proof or interpersonal accountability. Use when the task involves another person, comparison with a reference group, or coordinated action (Bergram et al. 2022, §4.1)."@en .

<https://w3id.org/calendar-bench/context#delivery_style/Disclosure> a owl:NamedIndividual , cbc:DeliveryStyle ;
    cb:slug      "disclosure" ;
    cb:category  cbc:DeliveryStyle ;
    rdfs:label   "disclosure-based delivery"@en ;
    cb:source    "Bergram 2022" ;
    dcterms:source cb:Source_Bergram_2022 ;
    skos:definition "The recommendation surfaces accessible, clear, relevant information at the point of choice (labels, ingredients, calories, caffeine, environmental impact). Use when the task asks the user to inspect / read / verify information before deciding (Bergram et al. 2022, §4.1)."@en .

<https://w3id.org/calendar-bench/context#delivery_style/Friction> a owl:NamedIndividual , cbc:DeliveryStyle ;
    cb:slug      "friction" ;
    cb:category  cbc:DeliveryStyle ;
    rdfs:label   "friction-based delivery"@en ;
    cb:source    "Bergram 2022" ;
    dcterms:source cb:Source_Bergram_2022 ;
    skos:definition "The recommendation adds or removes effort to discourage or encourage a behaviour. Remove friction by pre-positioning cues (carry bottle, set out gear); add friction against an unwanted behaviour (charge phone outside bedroom, block sites). Use when the mechanism is environment / effort restructuring (Bergram et al. 2022, §4.1)."@en .

<https://w3id.org/calendar-bench/context#delivery_style/DecoyDeception> a owl:NamedIndividual , cbc:DeliveryStyle ;
    cb:slug      "decoy_deception" ;
    cb:category  cbc:DeliveryStyle ;
    rdfs:label   "decoy / deception delivery"@en ;
    cb:source    "Bergram 2022" ;
    dcterms:source cb:Source_Bergram_2022 ;
    skos:definition "The recommendation covertly affects perception via decoy options or framing manipulation. Rarely appropriate for self-help / behaviour-change recommendations because it conflicts with autonomy and informed consent (Bergram et al. 2022, §4.1)."@en .

<https://w3id.org/calendar-bench/context#delivery_style/Feedback> a owl:NamedIndividual , cbc:DeliveryStyle ;
    cb:slug      "feedback" ;
    cb:category  cbc:DeliveryStyle ;
    rdfs:label   "feedback-based delivery"@en ;
    cb:source    "Bergram 2022" ;
    dcterms:source cb:Source_Bergram_2022 ;
    skos:definition "The recommendation provides information about a past or current behaviour (eco-score, step count, mood after a session). Use when the task asks the user to log, track, mark, or reflect on what they just did (Bergram et al. 2022, §4.1)."@en .

<https://w3id.org/calendar-bench/context#delivery_style/Warning> a owl:NamedIndividual , cbc:DeliveryStyle ;
    cb:slug      "warning" ;
    cb:category  cbc:DeliveryStyle ;
    rdfs:label   "warning-based delivery"@en ;
    cb:source    "Bergram 2022" ;
    dcterms:source cb:Source_Bergram_2022 ;
    skos:definition "The recommendation grabs attention to a risk or consequence so the user reconsiders the choice. Use when the task surfaces a barrier, a sensitive situation, or a chance to draw a boundary (Bergram et al. 2022, §4.1)."@en .

<https://w3id.org/calendar-bench/context#delivery_style/Scarcity> a owl:NamedIndividual , cbc:DeliveryStyle ;
    cb:slug      "scarcity" ;
    cb:category  cbc:DeliveryStyle ;
    rdfs:label   "scarcity-based delivery"@en ;
    cb:source    "Bergram 2022" ;
    dcterms:source cb:Source_Bergram_2022 ;
    skos:definition "The recommendation frames the option as scarce in time or quantity (\"only one room left\", \"last 5 minutes\"). Use when the task itself relies on a limited window (a seasonal food, a one-day-only event, a today-only commitment) (Bergram et al. 2022, §4.1)."@en .

<https://w3id.org/calendar-bench/context#delivery_style/Commitment> a owl:NamedIndividual , cbc:DeliveryStyle ;
    cb:slug      "commitment" ;
    cb:category  cbc:DeliveryStyle ;
    rdfs:label   "commitment-based delivery"@en ;
    cb:source    "Bergram 2022" ;
    dcterms:source cb:Source_Bergram_2022 ;
    skos:definition "The recommendation elicits an explicit advance commitment so the user is motivated to act consistently with it (preselecting which household devices to save energy on, signing a pledge, planning the act before the moment of temptation). Use when the task is a deliberate, written or stated, future-oriented commitment (Bergram et al. 2022, §4.1)."@en .


