    rdfs:label   "inform about environmental consequences BCT"@en ;
    cb:source    "BCIO" ;
    dcterms:source cb:Source_BCIO ;
    skos:definition "An <increase awareness of consequences BCT> that provides information about the environmental consequences of performing or not performing the behaviour."@en .

<http://humanbehaviourchange.org/ontology/BCIO_007063> a owl:NamedIndividual , cbc:BehaviourChangeTechnique ;
    cb:slug      "inform_about_health_consequences_bct" ;
    cb:category  cbc:BehaviourChangeTechnique ;
    rdfs:label   "inform about health consequences BCT"@en ;
