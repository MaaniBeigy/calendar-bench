    skos:definition "A <remove aversive consequence for outcome of behaviour BCT> in which the consequence is money, vouchers or other valued objects."@en .

<http://humanbehaviourchange.org/ontology/BCIO_007290> a owl:NamedIndividual , cbc:BehaviourChangeTechnique ;
    cb:slug      "remove_aversive_social_consequence_for_behaviour_bct" ;
