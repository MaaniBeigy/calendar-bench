<http://humanbehaviourchange.org/ontology/BCIO_007153> a owl:NamedIndividual , cbc:BehaviourChangeTechnique ;
    cb:slug      "reduce_exposure_to_cues_for_the_behaviour_bct" ;
    cb:category  cbc:BehaviourChangeTechnique ;
    rdfs:label   "reduce exposure to cues for the behaviour BCT"@en ;
    cb:source    "BCIO" ;
    dcterms:source cb:Source_BCIO ;
    skos:definition "An <alter external stimulus BCT> that reduces an external stimulus that signals the behaviour."@en .

<http://humanbehaviourchange.org/ontology/BCIO_007056> a owl:NamedIndividual , cbc:BehaviourChangeTechnique ;
    cb:slug      "reframe_past_behaviour_bct" ;
    cb:category  cbc:BehaviourChangeTechnique ;
    rdfs:label   "reframe past behaviour BCT"@en ;
    cb:source    "BCIO" ;
    dcterms:source cb:Source_BCIO ;
    skos:definition "A <suggest different perspective on behaviour BCT> that involves reattributing a person's successes to internal, stable or global factors or failures to external, unstable or specific factors."@en .

<http://humanbehaviourchange.org/ontology/BCIO_007060> a owl:NamedIndividual , cbc:BehaviourChangeTechnique ;
    cb:slug      "remind_about_personal_capability_bct" ;
    cb:category  cbc:BehaviourChangeTechnique ;
    rdfs:label   "remind about personal capability BCT"@en ;
    cb:source    "BCIO" ;
    dcterms:source cb:Source_BCIO ;
    skos:definition "A <prompt thinking related to successful performance BCT> that reminds the person of their skills and abilities that are relevant to the performance of the behaviour."@en .

<http://humanbehaviourchange.org/ontology/BCIO_007286> a owl:NamedIndividual , cbc:BehaviourChangeTechnique ;
    cb:slug      "remove_aversive_consequence_for_behaviour_bct" ;
