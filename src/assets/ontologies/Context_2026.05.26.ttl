    rdfs:label   "remove aversive consequence for behaviour BCT"@en ;
    cb:source    "BCIO" ;
    dcterms:source cb:Source_BCIO ;
    skos:definition "A <remove consequence for behaviour BCT> where the consequence is aversive."@en .

