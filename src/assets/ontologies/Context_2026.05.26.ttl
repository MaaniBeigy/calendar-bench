## ----------------------------------------------------------------------
## Calendar-Bench Context IRI dictionary (Turtle serialisation).
## Source : assets/ontologies/context_iris.json (version 2026.05.26)
## Script : src/scripts/generate_context_ttl.py
## Total IRIs: 535
## ----------------------------------------------------------------------

@prefix cb:      <https://w3id.org/calendar-bench/context/> .
@prefix cbc:     <https://w3id.org/calendar-bench/context/category/> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://w3id.org/calendar-bench/context/> a owl:Ontology ;
    dcterms:title       "Calendar-Bench Context IRI dictionary"@en ;
    dcterms:description "Curated dictionary of *momentary* context-feature IRIs for persona-based simulation. Stable user characteristics (full Big Five score, identity, etc.) belong in persona `characteristics:`, NOT here. Trait STATES (e.g. currently behaving in a high-extraversion manner) are included under `trait_state`. behaviour_state and capability_opportunity entries carry theory_mappings tying the IRI to TDF / COM-B / HAPA / TTM / SDT."@en ;
    dcterms:license     <https://creativecommons.org/licenses/by/4.0/> ;
    owl:versionInfo     "2026.05.26" ;
    dcterms:created     "2026-05-26"^^xsd:date .

## ----------------------------------------------------------------------
## Source ontologies (cb:sourcePrefix shows the IRI namespace pattern).
## ----------------------------------------------------------------------
cb:Source_MFOEM a cb:OntologySource ;
    rdfs:label      "MFOEM"@en ;
    cb:sourcePrefix "http://purl.obolibrary.org/obo/MFOEM_*" .

cb:Source_BCIO a cb:OntologySource ;
    rdfs:label      "BCIO"@en ;
    cb:sourcePrefix "http://humanbehaviourchange.org/ontology/BCIO_*" .

cb:Source_ENVO a cb:OntologySource ;
    rdfs:label      "ENVO"@en ;
    cb:sourcePrefix "http://purl.obolibrary.org/obo/ENVO_*" .

cb:Source_OMRSE a cb:OntologySource ;
    rdfs:label      "OMRSE"@en ;
    cb:sourcePrefix "http://purl.obolibrary.org/obo/OMRSE_*" .

cb:Source_COPPER a cb:OntologySource ;
    rdfs:label      "COPPER"@en ;
    cb:sourcePrefix "https://github.com/EBehaviourChange-COPPER/ontology/blob/main/COPPER_*" .

cb:Source_EFO a cb:OntologySource ;
    rdfs:label      "EFO"@en ;
    cb:sourcePrefix "http://www.ebi.ac.uk/efo/EFO_* (Experimental Factor Ontology, EBI)" .

cb:Source_OCHV a cb:OntologySource ;
    rdfs:label      "OCHV"@en ;
    cb:sourcePrefix "http://sbmi.uth.tmc.edu/ontology/ochv#*" .

cb:Source_ADDICTO a cb:OntologySource ;
    rdfs:label      "ADDICTO"@en ;
    cb:sourcePrefix "http://addictovocab.org/ADDICTO_*" .

cb:Source_Bergram_2022 a cb:OntologySource ;
    rdfs:label      "Bergram 2022"@en ;
    cb:sourcePrefix "https://w3id.org/calendar-bench/context#delivery_style/* (Bergram, Djurica, Sundar & Aleta 2022 digital-nudging taxonomy)" .

cb:Source_calendar_bench a cb:OntologySource ;
    rdfs:label      "calendar-bench"@en ;
    cb:sourcePrefix "https://w3id.org/calendar-bench/context#trait/* (local trait-state IRIs)" .


## ----------------------------------------------------------------------
## Datatype / object properties carrying per-entry metadata.
## ----------------------------------------------------------------------

cb:slug a owl:DatatypeProperty ;
    rdfs:comment "snake_case identifier used in HealthTasks `context_links`."@en ;
    rdfs:range  xsd:string .

cb:category a owl:ObjectProperty ;
    rdfs:comment "Category class this entry belongs to (cbc: namespace)."@en .

cb:source a owl:DatatypeProperty ;
    rdfs:comment "Source ontology key (matches cb:Source_*)."@en ;
    rdfs:range  xsd:string .

cb:polarity a owl:DatatypeProperty ;
    rdfs:comment "Direction of a trait state ('high' or 'low')."@en ;
    rdfs:range  xsd:string .

cb:instrument a owl:DatatypeProperty ;
    rdfs:comment "Personality instrument the trait state is anchored to (BFI, TCI, BIS-11, LOT-R, SSS-V)."@en ;
    rdfs:range  xsd:string .

cb:ttmLabel a owl:DatatypeProperty ;
    rdfs:comment "Canonical TTM-process label (Prochaska & DiClemente)."@en ;
    rdfs:range  xsd:string .

cb:sdtLabel a owl:DatatypeProperty ;
    rdfs:comment "Canonical SDT-regulation label (Deci & Ryan)."@en ;
    rdfs:range  xsd:string .

cb:hapaLabel a owl:DatatypeProperty ;
    rdfs:comment "Canonical HAPA-phase label (Schwarzer)."@en ;
    rdfs:range  xsd:string .

cb:theoryMapping a owl:ObjectProperty ;
    rdfs:comment "Block tying an IRI to TDF / COM-B / HAPA / TTM / SDT."@en .

cb:tdfDomain a owl:DatatypeProperty ;
    rdfs:comment "TDF v2 domain label (Atkins 2017 Table 1)."@en ;
    rdfs:range  xsd:string .

cb:comb a owl:DatatypeProperty ;
    rdfs:comment "COM-B component (Michie, van Stralen & West 2011)."@en ;
    rdfs:range  xsd:string .

cb:hapa a owl:DatatypeProperty ;
    rdfs:comment "HAPA phase (Schwarzer 1992, rev. 2008)."@en ;
    rdfs:range  xsd:string .

cb:ttmProcess a owl:DatatypeProperty ;
    rdfs:comment "TTM process (Prochaska & DiClemente 10 processes)."@en ;
    rdfs:range  xsd:string .

cb:ttmStage a owl:DatatypeProperty ;
    rdfs:comment "TTM stage of change."@en ;
    rdfs:range  xsd:string .

cb:sdtRegulation a owl:DatatypeProperty ;
    rdfs:comment "SDT regulation on the organismic-integration continuum."@en ;
    rdfs:range  xsd:string .

cb:sdtNeed a owl:DatatypeProperty ;
    rdfs:comment "SDT basic psychological need (autonomy, competence, relatedness)."@en ;
    rdfs:range  xsd:string .

cb:sourcePrefix a owl:DatatypeProperty ;
    rdfs:comment "IRI namespace pattern for a source ontology."@en ;
    rdfs:range  xsd:string .

cb:total a owl:DatatypeProperty ;
    rdfs:comment "Entry count for a category."@en ;
    rdfs:range  xsd:integer .


## ----------------------------------------------------------------------
## Category classes (each entry has rdf:type one of these).
## ----------------------------------------------------------------------

cb:ContextFeature a owl:Class ;
    rdfs:label   "Context feature"@en ;
    rdfs:comment "Any momentary context-feature concept curated in this dictionary."@en .

cbc:MoodEmotionContext a owl:Class ;
