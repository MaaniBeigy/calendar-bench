<http://humanbehaviourchange.org/ontology/BCIO_007064> a owl:NamedIndividual , cbc:BehaviourChangeTechnique ;
    cb:slug      "inform_about_social_consequences_bct" ;
    cb:category  cbc:BehaviourChangeTechnique ;
    rdfs:label   "inform about social consequences BCT"@en ;
    cb:source    "BCIO" ;
    dcterms:source cb:Source_BCIO ;
    skos:definition "An <increase awareness of consequences BCT> that provides information about the social consequences of performing or not performing the behaviour."@en .

<http://humanbehaviourchange.org/ontology/BCIO_007058> a owl:NamedIndividual , cbc:BehaviourChangeTechnique ;
    cb:slug      "instruct_how_to_perform_a_behaviour_bct" ;
    cb:category  cbc:BehaviourChangeTechnique ;
    rdfs:label   "instruct how to perform a behaviour BCT"@en ;
    cb:source    "BCIO" ;
    dcterms:source cb:Source_BCIO ;
    skos:definition "A <guide how to perform behaviour BCT> that involves telling the person how to perform the behaviour."@en .

<http://humanbehaviourchange.org/ontology/BCIO_007122> a owl:NamedIndividual , cbc:BehaviourChangeTechnique ;
    cb:slug      "make_a_goal_public_bct" ;
    cb:category  cbc:BehaviourChangeTechnique ;
    rdfs:label   "make a goal public BCT"@en ;
    cb:source    "BCIO" ;
    dcterms:source cb:Source_BCIO ;
    skos:definition "A <goal directed BCT> that involves the person communicating their intention to achieve a goal."@en .

<http://humanbehaviourchange.org/ontology/BCIO_007185> a owl:NamedIndividual , cbc:BehaviourChangeTechnique ;
    cb:slug      "manage_mental_processes_bct" ;
    cb:category  cbc:BehaviourChangeTechnique ;
    rdfs:label   "manage mental processes BCT"@en ;
    cb:source    "BCIO" ;
    dcterms:source cb:Source_BCIO ;
    skos:definition "A <behaviour change technique> that advises how to manage mental processes to facilitate the behaviour."@en .

<http://humanbehaviourchange.org/ontology/BCIO_007066> a owl:NamedIndividual , cbc:BehaviourChangeTechnique ;
    cb:slug      "monitor_emotional_consequences_bct" ;
    cb:category  cbc:BehaviourChangeTechnique ;
    rdfs:label   "monitor emotional consequences BCT"@en ;
    cb:source    "BCIO" ;
    dcterms:source cb:Source_BCIO ;
    skos:definition "A <monitoring BCT> that involves the person assessing their emotions after performing the behaviour."@en .

<http://humanbehaviourchange.org/ontology/BCIO_007017> a owl:NamedIndividual , cbc:BehaviourChangeTechnique ;
    cb:slug      "monitoring_bct" ;
    cb:category  cbc:BehaviourChangeTechnique ;
    rdfs:label   "monitoring BCT"@en ;
    cb:source    "BCIO" ;
    dcterms:source cb:Source_BCIO ;
    skos:definition "A <behaviour change technique> that involves gathering or using information about performance."@en .

<http://humanbehaviourchange.org/ontology/BCIO_007018> a owl:NamedIndividual , cbc:BehaviourChangeTechnique ;
    cb:slug      "observe_behaviour_without_feedback_bct" ;
    cb:category  cbc:BehaviourChangeTechnique ;
    rdfs:label   "observe behaviour without feedback BCT"@en ;
    cb:source    "BCIO" ;
    dcterms:source cb:Source_BCIO ;
    skos:definition "A <monitoring BCT> that observes current performance of the behaviour with the person’s knowledge but without providing feedback about their behaviour."@en .

<http://humanbehaviourchange.org/ontology/BCIO_007020> a owl:NamedIndividual , cbc:BehaviourChangeTechnique ;
    cb:slug      "observe_outcome_of_behaviour_without_feedback_bct" ;
    cb:category  cbc:BehaviourChangeTechnique ;
    rdfs:label   "observe outcome of behaviour without feedback BCT"@en ;
    cb:source    "BCIO" ;
    dcterms:source cb:Source_BCIO ;
    skos:definition "A <monitoring BCT> that observes an outcome of performing the behaviour with the person’s knowledge but without providing feedback about the outcome."@en .

<http://humanbehaviourchange.org/ontology/BCIO_007186> a owl:NamedIndividual , cbc:BehaviourChangeTechnique ;
    cb:slug      "outcome_consequence_bct" ;
    cb:category  cbc:BehaviourChangeTechnique ;
    rdfs:label   "outcome consequence BCT"@en ;
    cb:source    "BCIO" ;
    dcterms:source cb:Source_BCIO ;
    skos:definition "A <behaviour change technique> that alters the consequences or promised consequences for an outcome that results from performing or not performing the behaviour."@en .

<http://humanbehaviourchange.org/ontology/BCIO_007098> a owl:NamedIndividual , cbc:BehaviourChangeTechnique ;
    cb:slug      "overcorrect_unwanted_behaviour_bct" ;
    cb:category  cbc:BehaviourChangeTechnique ;
    rdfs:label   "overcorrect unwanted behaviour BCT"@en ;
    cb:source    "BCIO" ;
    dcterms:source cb:Source_BCIO ;
    skos:definition "An <advise specific behaviour BCT> that advises the person to repeat a wanted behaviour in an exaggerated way following performance of an unwanted behaviour."@en .

<http://humanbehaviourchange.org/ontology/BCIO_007137> a owl:NamedIndividual , cbc:BehaviourChangeTechnique ;
    cb:slug      "persuade_about_personal_capability_bct" ;
    cb:category  cbc:BehaviourChangeTechnique ;
    rdfs:label   "persuade about personal capability BCT"@en ;
    cb:source    "BCIO" ;
    dcterms:source cb:Source_BCIO ;
    skos:definition "A <prompt thinking related to successful performance BCT> that persuades the person that they can successfully perform the behaviour."@en .

<http://humanbehaviourchange.org/ontology/BCIO_007061> a owl:NamedIndividual , cbc:BehaviourChangeTechnique ;
    cb:slug      "plan_inclusion_of_enjoyment_bct" ;
    cb:category  cbc:BehaviourChangeTechnique ;
    rdfs:label   "plan inclusion of enjoyment BCT"@en ;
    cb:source    "BCIO" ;
    dcterms:source cb:Source_BCIO ;
    skos:definition "A <goal directed BCT> that advises the person to plan a way of performing the behaviour that is pleasurable or satisfying."@en .

<http://humanbehaviourchange.org/ontology/BCIO_007094> a owl:NamedIndividual , cbc:BehaviourChangeTechnique ;
    cb:slug      "practise_behaviour_bct" ;
    cb:category  cbc:BehaviourChangeTechnique ;
    rdfs:label   "practise behaviour BCT"@en ;
    cb:source    "BCIO" ;
    dcterms:source cb:Source_BCIO ;
    skos:definition "An <advise specific behaviour BCT> that advises repetition of the behaviour in a way that has the function of increasing the skill in performing the behaviour."@en .

<http://humanbehaviourchange.org/ontology/BCIO_007075> a owl:NamedIndividual , cbc:BehaviourChangeTechnique ;
    cb:slug      "present_information_from_credible_influence_bct" ;
    cb:category  cbc:BehaviourChangeTechnique ;
    rdfs:label   "present information from credible influence BCT"@en ;
    cb:source    "BCIO" ;
    dcterms:source cb:Source_BCIO ;
    skos:definition "An <awareness of other people's thoughts, feelings and actions BCT> that presents information from a credible person or organisation to influence the behaviour."@en .

<http://humanbehaviourchange.org/ontology/BCIO_007189> a owl:NamedIndividual , cbc:BehaviourChangeTechnique ;
    cb:slug      "promise_aversive_consequence_for_behaviour_bct" ;
    cb:category  cbc:BehaviourChangeTechnique ;
    rdfs:label   "promise aversive consequence for behaviour BCT"@en ;
    cb:source    "BCIO" ;
    dcterms:source cb:Source_BCIO ;
    skos:definition "A <promise consequence for behaviour BCT> where the consequence is aversive."@en .

<http://humanbehaviourchange.org/ontology/BCIO_007195> a owl:NamedIndividual , cbc:BehaviourChangeTechnique ;
    cb:slug      "promise_aversive_consequence_for_outcome_of_behaviour_bct" ;
    cb:category  cbc:BehaviourChangeTechnique ;
    rdfs:label   "promise aversive consequence for outcome of behaviour BCT"@en ;
    cb:source    "BCIO" ;
    dcterms:source cb:Source_BCIO ;
    skos:definition "A <promise consequence for outcome of behaviour BCT> where the consequence is aversive."@en .

<http://humanbehaviourchange.org/ontology/BCIO_007191> a owl:NamedIndividual , cbc:BehaviourChangeTechnique ;
    cb:slug      "promise_aversive_consequence_for_situation_specific_behaviour_bct" ;
    cb:category  cbc:BehaviourChangeTechnique ;
    rdfs:label   "promise aversive consequence for situation specific behaviour BCT"@en ;
    cb:source    "BCIO" ;
    dcterms:source cb:Source_BCIO ;
    skos:definition "A <promise aversive consequence for behaviour BCT> that promises the consequence will be provided for the behaviour in one situation but not in another."@en .

<http://humanbehaviourchange.org/ontology/BCIO_007192> a owl:NamedIndividual , cbc:BehaviourChangeTechnique ;
    cb:slug      "promise_aversive_material_consequence_for_behaviour_bct" ;
    cb:category  cbc:BehaviourChangeTechnique ;
    rdfs:label   "promise aversive material consequence for behaviour BCT"@en ;
    cb:source    "BCIO" ;
    dcterms:source cb:Source_BCIO ;
    skos:definition "A <promise aversive consequence for behaviour BCT> where the consequence is money, vouchers or other valued objects."@en .

<http://humanbehaviourchange.org/ontology/BCIO_007194> a owl:NamedIndividual , cbc:BehaviourChangeTechnique ;
    cb:slug      "promise_aversive_material_consequence_for_outcome_of_behaviour" ;
    cb:category  cbc:BehaviourChangeTechnique ;
    rdfs:label   "promise aversive material consequence for outcome of behaviour"@en ;
    cb:source    "BCIO" ;
    dcterms:source cb:Source_BCIO ;
    skos:definition "A <promise aversive consequence for outcome of behaviour BCT> where the consequence is money, vouchers or other valued objects."@en .

<http://humanbehaviourchange.org/ontology/BCIO_007193> a owl:NamedIndividual , cbc:BehaviourChangeTechnique ;
    cb:slug      "promise_aversive_material_consequence_for_situation_specific_behaviour_bct" ;
    cb:category  cbc:BehaviourChangeTechnique ;
    rdfs:label   "promise aversive material consequence for situation specific behaviour BCT"@en ;
    cb:source    "BCIO" ;
    dcterms:source cb:Source_BCIO ;
    skos:definition "A <promise aversive consequence for situation specific behaviour BCT> in which the consequence is money, vouchers or other valued objects."@en .

<http://humanbehaviourchange.org/ontology/BCIO_007197> a owl:NamedIndividual , cbc:BehaviourChangeTechnique ;
    cb:slug      "promise_aversive_social_consequence_for_behaviour_bct" ;
    cb:category  cbc:BehaviourChangeTechnique ;
    rdfs:label   "promise aversive social consequence for behaviour BCT"@en ;
    cb:source    "BCIO" ;
    dcterms:source cb:Source_BCIO ;
    skos:definition "A <promise aversive consequence for behaviour BCT> where the consequence is an interpersonal process or a proxy interpersonal process."@en .

<http://humanbehaviourchange.org/ontology/BCIO_007199> a owl:NamedIndividual , cbc:BehaviourChangeTechnique ;
    cb:slug      "promise_aversive_social_consequence_for_outcome_of_behaviour_bct" ;
    cb:category  cbc:BehaviourChangeTechnique ;
    rdfs:label   "promise aversive social consequence for outcome of behaviour BCT"@en ;
    cb:source    "BCIO" ;
    dcterms:source cb:Source_BCIO ;
    skos:definition "A <promise aversive consequence for outcome of behaviour BCT> where the consequence is an interpersonal process or a proxy interpersonal process."@en .

<http://humanbehaviourchange.org/ontology/BCIO_007198> a owl:NamedIndividual , cbc:BehaviourChangeTechnique ;
    cb:slug      "promise_aversive_social_consequence_for_situation_specific_behaviour_bct" ;
    cb:category  cbc:BehaviourChangeTechnique ;
    rdfs:label   "promise aversive social consequence for situation specific behaviour BCT"@en ;
    cb:source    "BCIO" ;
    dcterms:source cb:Source_BCIO ;
    skos:definition "A <promise aversive consequence for situation specific behaviour BCT> in which the consequence is an interpersonal process or a proxy interpersonal process."@en .

<http://humanbehaviourchange.org/ontology/BCIO_007187> a owl:NamedIndividual , cbc:BehaviourChangeTechnique ;
    cb:slug      "promise_consequence_for_behaviour_bct" ;
    cb:category  cbc:BehaviourChangeTechnique ;
    rdfs:label   "promise consequence for behaviour BCT"@en ;
    cb:source    "BCIO" ;
    dcterms:source cb:Source_BCIO ;
    skos:definition "A <behavioural consequence BCT> that promises a future consequence contingent on performing or not performing the behaviour."@en .

<http://humanbehaviourchange.org/ontology/BCIO_007200> a owl:NamedIndividual , cbc:BehaviourChangeTechnique ;
    cb:slug      "promise_consequence_for_outcome_of_behaviour_bct" ;
    cb:category  cbc:BehaviourChangeTechnique ;
    rdfs:label   "promise consequence for outcome of behaviour BCT"@en ;
    cb:source    "BCIO" ;
    dcterms:source cb:Source_BCIO ;
    skos:definition "An <outcome consequence BCT> that promises a future consequence contingent on an outcome of performing or not performing the behaviour."@en .

<http://humanbehaviourchange.org/ontology/BCIO_007204> a owl:NamedIndividual , cbc:BehaviourChangeTechnique ;
    cb:slug      "promise_positive_consequence_for_alternative_behaviour_bct" ;
    cb:category  cbc:BehaviourChangeTechnique ;
    rdfs:label   "promise positive consequence for alternative behaviour BCT"@en ;
    cb:source    "BCIO" ;
    dcterms:source cb:Source_BCIO ;
    skos:definition "A <promise positive consequence for behaviour BCT> that promises the consequence will be provided for the behaviour that is different from the unwanted behaviour."@en .

<http://humanbehaviourchange.org/ontology/BCIO_007205> a owl:NamedIndividual , cbc:BehaviourChangeTechnique ;
    cb:slug      "promise_positive_consequence_for_approximating_behaviour_bct" ;
    cb:category  cbc:BehaviourChangeTechnique ;
    rdfs:label   "promise positive consequence for approximating behaviour BCT"@en ;
    cb:source    "BCIO" ;
    dcterms:source cb:Source_BCIO ;
    skos:definition "A <promise positive consequence for behaviour BCT> where the consequence is provided as the performance gradually gets closer to the behaviour."@en .

<http://humanbehaviourchange.org/ontology/BCIO_007202> a owl:NamedIndividual , cbc:BehaviourChangeTechnique ;
    cb:slug      "promise_positive_consequence_for_behaviour_bct" ;
    cb:category  cbc:BehaviourChangeTechnique ;
    rdfs:label   "promise positive consequence for behaviour BCT"@en ;
    cb:source    "BCIO" ;
    dcterms:source cb:Source_BCIO ;
    skos:definition "A <promise consequence for behaviour BCT> where the consequence is positive."@en .

<http://humanbehaviourchange.org/ontology/BCIO_007206> a owl:NamedIndividual , cbc:BehaviourChangeTechnique ;
    cb:slug      "promise_positive_consequence_for_completion_of_behavioural_sequence_bct" ;
    cb:category  cbc:BehaviourChangeTechnique ;
    rdfs:label   "promise positive consequence for completion of behavioural sequence BCT"@en ;
    cb:source    "BCIO" ;
    dcterms:source cb:Source_BCIO ;
    skos:definition "A <promise positive consequence for behaviour BCT> in which the consequence will be provided for performing the final behaviour in a sequence of behaviours, followed by adding behaviours that occur earlier in the sequence."@en .

<http://humanbehaviourchange.org/ontology/BCIO_007207> a owl:NamedIndividual , cbc:BehaviourChangeTechnique ;
    cb:slug      "promise_positive_consequence_for_incompatible_behaviour_bct" ;
    cb:category  cbc:BehaviourChangeTechnique ;
    rdfs:label   "promise positive consequence for incompatible behaviour BCT"@en ;
    cb:source    "BCIO" ;
    dcterms:source cb:Source_BCIO ;
    skos:definition "A <promise positive consequence for behaviour BCT> that promises the consequence will be provided for the behaviour that is incompatible with the unwanted behaviour."@en .

<http://humanbehaviourchange.org/ontology/BCIO_007216> a owl:NamedIndividual , cbc:BehaviourChangeTechnique ;
    cb:slug      "promise_positive_consequence_for_outcome_of_behaviour_bct" ;
    cb:category  cbc:BehaviourChangeTechnique ;
    rdfs:label   "promise positive consequence for outcome of behaviour BCT"@en ;
    cb:source    "BCIO" ;
    dcterms:source cb:Source_BCIO ;
    skos:definition "A <promise consequence for outcome of behaviour BCT> where the consequence is positive"@en .

<http://humanbehaviourchange.org/ontology/BCIO_007208> a owl:NamedIndividual , cbc:BehaviourChangeTechnique ;
    cb:slug      "promise_positive_consequence_for_situation_specific_behaviour_bct" ;
    cb:category  cbc:BehaviourChangeTechnique ;
    rdfs:label   "promise positive consequence for situation specific behaviour BCT"@en ;
    cb:source    "BCIO" ;
