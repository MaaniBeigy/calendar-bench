<http://humanbehaviourchange.org/ontology/BCIO_050331> a owl:NamedIndividual , cbc:BehaviourChangeTechnique ;
    cb:slug      "remove_aversive_stimulus_bct" ;
    cb:category  cbc:BehaviourChangeTechnique ;
    rdfs:label   "remove aversive stimulus BCT"@en ;
    cb:source    "BCIO" ;
    dcterms:source cb:Source_BCIO ;
    skos:definition "An <alter external stimulus BCT> that involves removing an aversive stimulus to bring about behaviour change."@en .

<http://humanbehaviourchange.org/ontology/BCIO_007285> a owl:NamedIndividual , cbc:BehaviourChangeTechnique ;
