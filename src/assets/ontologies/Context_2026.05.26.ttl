<http://purl.obolibrary.org/obo/MFOEM_000001> a owl:NamedIndividual , cbc:MoodEmotionContext ;
    cb:slug      "emotion_process" ;
    cb:category  cbc:MoodEmotionContext ;
    rdfs:label   "emotion process"@en ;
    cb:source    "MFOEM" ;
    dcterms:source cb:Source_MFOEM ;
    skos:definition "An <affective process> that is a synchronized aggregate of constituent mental processes, including an appraisal process, which is valenced, has an object, and gives rise to an action tendency."@en .

